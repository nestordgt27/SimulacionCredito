# Plantilla de variables de entorno para desarrollo local.
# Copiar a .env (no versionado): cp .env.example .env

NODE_ENV=development
PORT=3000

# SQLite local. La ruta se resuelve desde src/prisma/schema.prisma,
# así que el archivo queda en apps/api/data/dev.db (carpeta ignorada por Git).
DATABASE_URL="file:../../data/dev.db"

# Origen del frontend (Vite) permitido por CORS.
CORS_ORIGIN=http://localhost:5173

# Autenticación. El secreto debe tener al menos 32 caracteres; genera uno propio con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Access token de corta duración (15 minutos)
JWT_ACCESS_TTL_SEGUNDOS=900
# Refresh token rotativo
REFRESH_TOKEN_TTL_DIAS=7
