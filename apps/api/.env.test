# Variables de entorno para pruebas (integración y e2e). Versionado: no contiene secretos.
# Jest define NODE_ENV=test y la app carga este archivo en lugar de .env.

NODE_ENV=test
PORT=3001

# Base de datos de prueba separada de la de desarrollo: apps/api/data/test.db
DATABASE_URL="file:../../data/test.db"

CORS_ORIGIN=http://localhost:5173
